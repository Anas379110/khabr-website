// ***Add a global font loading strategy for Arabic***
//   • We use the "IBM Plex Sans Arabic" font which is already referenced in Tailwind.
//   • Load the WOFF2 variant, pre‑connect, and define a fallback chain.

// In `src/layouts/BaseLayout.astro` (or a separate global component):

---
const fontUrl = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;700&display=swap';
---

<style>
/* 1️⃣ Pre‑connect to Google Fonts */
@import url('$fontUrl');
/* 2️⃣ Configure root font family (fallback to system) */
:root {
  font-family: 'IBM Plex Sans Arabic', ui-sans-serif, system-ui, sans-serif;
}
</style>

// Put the style block at the top of the page so it loads early.
// No extra JS required – this works for static Astro sites.
