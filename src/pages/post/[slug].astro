---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublished, isSensitive } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', isPublished);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await post.render();
const sensitive = isSensitive(post);
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article>
    <div class="flex items-center gap-2 flex-wrap">
      <span class={`text-xs font-medium px-2 py-0.5 rounded ${post.data.type === 'خبر' ? 'bg-neutral-200 text-neutral-800' : 'bg-brand/10 text-brand'}`}>
        {post.data.type}
      </span>
      {sensitive && (
        <span class="text-xs bg-brand-alert/10 text-brand-alert px-2 py-0.5 rounded">محتوى حساس — قيد المراجعة</span>
      )}
      {post.data.unverifiedSingleSource && (
        <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded">مصدر واحد غير مؤكد</span>
      )}
    </div>
    <h1 class="text-3xl font-bold mt-2 mb-2">{post.data.title}</h1>
    <time class="text-sm text-neutral-500 block mb-6">
      {new Intl.DateTimeFormat('ar', { dateStyle: 'long' }).format(post.data.publishDate)}
    </time>

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>

    <div class="mt-8 pt-4 border-t border-neutral-200 text-sm text-neutral-600">
      <strong>المصادر:</strong>
      <ul class="list-disc list-inside">
        {post.data.sources.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </article>
</BaseLayout>
