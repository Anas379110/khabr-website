# Update each site package.json to expose bundle-size script
# Example: sites/khabr/package.json (same pattern for all sites)
{
  "scripts": {
    "build": "astro build",
    "bundle-size": "node ../../scripts/report-bundle-size.js",
    "lighthouse:home": "node scripts/lighthouse.js home"
  }
}
# Use the same pattern for all other static sites.
